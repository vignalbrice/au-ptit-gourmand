---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
---

<!-- Page affichée après l'envoi du formulaire traiteur (action du formulaire). -->
<BaseLayout title="Demande envoyée" crumb="Traiteur" noindex>
  <PageHero
    eyebrow="Traiteur"
    title="Merci, c'est envoyé."
    lead="On a bien reçu ta demande. On te recontacte très vite pour en parler."
  >
    <div class="mt-7 flex flex-wrap gap-3 motion-safe:animate-[rise_0.7s_0.25s_var(--ease-out)_both]">
      <a href="/menu" class="btn btn-blanc">
        Voir le menu
        <Icon name="arrow" size={18} />
      </a>
      <a href="/" class="btn btn-outline-blanc">Retour à l'accueil</a>
    </div>
  </PageHero>
</BaseLayout>
